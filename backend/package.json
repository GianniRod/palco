{
  "name": "palco-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db.mjs seed",
    "test": "node --env-file-if-exists=.env.local --test tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.11.0",
    "@neon/env": "^1.6.12",
    "@node-rs/argon2": "^2.2.2",
    "pg": "^8.23.1"
  }
}
