# Formulario "Pedir demo" (src/app/api/demo/route.ts)
# API key de https://resend.com (el dominio palcotickets.com tiene que estar verificado en Resend)
RESEND_API_KEY=
# Opcionales
# DEMO_TO=contacto@palcotickets.com
# DEMO_FROM=Palco Web <web@palcotickets.com>
# Remitente del email de recupero de contraseña del panel
# DASHBOARD_FROM=Palco <no-responder@palcotickets.com>

# Panel (dashboard.palcotickets.com): base Postgres de backend/. Sin esto el panel no funciona.
DATABASE_URL=

# Cobro con Mercado Pago (backend/src/mercadopago.mjs). Sin MP_ACCESS_TOKEN, en desarrollo se usa el pago simulado.
# Etapa 1: Access Token de PRUEBA de la app de Nightowl (Tus integraciones → Credenciales de prueba).
MP_ACCESS_TOKEN=
# Firma secreta de Webhooks → Configurar notificaciones (URL: https://www.nightowl.com.ar/api/webhooks/mercadopago?source_news=webhooks, evento Pagos). En producción sin esto se rechazan los avisos.
MP_WEBHOOK_SECRET=
# Para la etapa 2 (cada boliche conecta su cuenta por OAuth)
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# Opcional: URL pública (túnel) para recibir webhooks en local. En producción es https://www.nightowl.com.ar
# MP_WEBHOOK_BASE_URL=
# En producción la compra está apagada; "true" la enciende (para probar con el token de prueba)
# CHECKOUT_ENABLED=
